+class TwoPredFlight(RelPredFlight):
+    """As RelPredFlight, but every prediction is made twice: CL target held with no more braking (pred) and with
+    full braking from now (fb). Features add fb range / speed errors, a full-brake-infeasible flag and the brake
+    fraction beta = (V_pred - V*) / (V_pred - V_fb) the full brake would have to be applied for (linear)."""
+
+    def _predict(self):
+        self.npred += 2
+        self.last_pred_t = self.t
+        kl, kd = self.est.values
+        sc = dataclasses.replace(self.sc, k_lift=float(np.clip(kl, .7, 1.3)), k_drag=float(np.clip(kd, .7, 1.3)))
+        res = []
+        for wl, dcl in ((0., 0.), (1., 0.), (0., DCL)):
+            p = F.TargetFlight.fork(self)
+            p.field = B._Const(self.k_rho())
+            p.sc = sc
+            p.w = dict(self.w, dt=self.pdt)
+            F.TargetFlight.advance(p, self.w['T']-p.t, _hold(self.cl_t+dcl, wl))
+            res.append((np.array([p.range_km(), p.x[1]]), bool(p.failed)))
+        self.npred += 1
+        self.pred, _ = res[0]
+        self.fb, self.fb_fail = res[1]
+        self.gc = (res[2][0]-res[0][0])/DCL            # d(range, speed)/d(CL target), no brake
+
+    def features(self, extra=False):
+        base = F.TargetFlight.features(self, extra)
+        if not extra:
+            return base
+        tg = np.array([self.target.range_km, self.target.speed_mps])
+        e, f = self.pred-tg, self.fb-tg
+        beta = float(np.clip((self.pred[1]-tg[1])/max(self.pred[1]-self.fb[1], 1.), -1., 2.))
+        return base+[float(e[0])/100., float(e[1])/100., self.w_cur, self.cl_t*10.,
+                     float(f[0])/100., float(f[1])/100., float(self.fb_fail), beta,
+                     float(self.gc[0])*0.001, float(self.gc[1])*0.001]
+
+    def fork(self):
+        c = super().fork()
+        c.fb, c.fb_fail = self.fb.copy(), self.fb_fail
+        c.gc = self.gc.copy()
+        return c
+
